{
  "contract_name": "iris_classifier_inference",
  "contract_version": "1.0.0",
 "description": "Contrato de validacion de datos para el modelo de clasificacion Iris. Las medidas estan expresadas en centimetros.",
  "input_type": "object",
  "additional_properties": false,
  "required": ["sepal_length", "sepal_width", "petal_length", "petal_width"],
  "features": {
    "sepal_length": {"type": "number", "min": 4.0, "max": 8.0, "unit": "cm", "nullable": false},
    "sepal_width": {"type": "number", "min": 2.0, "max": 4.5, "unit": "cm", "nullable": false},
    "petal_length": {"type": "number", "min": 1.0, "max": 7.0, "unit": "cm", "nullable": false},
    "petal_width": {"type": "number", "min": 0.1, "max": 2.5, "unit": "cm", "nullable": false}
  },
  "target": {"name": "species", "type": "integer", "allowed_values": [0, 1, 2], "labels": {"0": "setosa", "1": "versicolor", "2": "virginica"}},
  "examples": {
    "valid": {"sepal_length": 5.1, "sepal_width": 3.5, "petal_length": 1.4, "petal_width": 0.2},
    "invalid": {"sepal_length": 99.0, "sepal_width": null, "petal_length": 1.4, "petal_width": "0.2"}
  },
  "data_quality_policy": "Registros con valores faltantes, no numericos, infinitos, NaN o fuera de estos rangos se rechazan antes del entrenamiento y de la futura inferencia. Los rangos son limites didacticos para Iris, no reglas botanicas universales."
}
